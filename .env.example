# Copy to .env; create the bot with Telegram's BotFather. Never commit the real .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# Compose sets internal Redis/Postgres URLs for each service.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://recorder:change-me@postgres:5432/recorder
RECORDINGS_DIR=/data/recordings
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Required before exposing the HTTP API publicly. Send via X-API-Key header.
API_BEARER_TOKEN=replace-with-a-long-random-secret
# Optional comma-separated Telegram numeric user IDs. Empty means anyone can submit bot commands.
ALLOWED_TELEGRAM_USER_IDS=

# Telegram cloud bot upload cap configured conservatively; tune only for a compatible Bot API server.
MAX_UPLOAD_MB=49
MAX_RECORDING_HOURS=12
PROBE_TIMEOUT_SECONDS=90
RETENTION_DAYS=14
